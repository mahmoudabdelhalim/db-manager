{
    "name": "mahmoudabdelhalim/db-manager",
    "description": "A Laravel MySQL database manager UI package",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "database", "mysql", "manager"],
    "authors": [
        {
            "name": "MahmoudAbdElhalim",
            "email": "mahmoud@grandercodes.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/routing": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/view": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "MahmoudAbdElhalim\\DbManager\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MahmoudAbdElhalim\\DbManager\\DbManagerServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
